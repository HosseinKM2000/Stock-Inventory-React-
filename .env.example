# Copy this file to .env. Replace every change-me placeholder before use.
ENVIRONMENT=development
SECRET_KEY=change-me-with-a-long-random-signing-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

POSTGRES_DB=tanzim
POSTGRES_USER=tanzim_app
POSTGRES_PASSWORD=change-me-with-a-long-random-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tanzim_app:change-me-with-a-long-random-database-password@127.0.0.1:5432/tanzim

# Set only while running `python -m app.bootstrap_admin`, then remove it.
SYSTEM_ADMIN_PASSWORD=

VITE_API_URL=http://localhost:8000/api
