{
  "name": "tanzim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "vitest run --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest --project unit --project component",
    "test:coverage": "vitest run --coverage --project unit --project component",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m pytest -c backend\\pytest.ini backend\\tests --ignore=backend\\tests\\test_postgresql.py",
    "test:backend:postgres": "backend\\.venv\\Scripts\\python.exe -m pytest -c backend\\pytest.ini backend\\tests\\test_postgresql.py",
    "test:e2e": "playwright test",
    "test:regression": "npm run test && npm run test:typecheck && npm run test:backend && npm run build && npm run lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
