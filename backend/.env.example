# Prefer copying the repository-root .env.example to ../.env so Docker Compose
# and FastAPI read one configuration. This backend-local file remains supported.
ENVIRONMENT=development
SECRET_KEY=change-me-with-a-long-random-signing-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql+psycopg://tanzim_app:change-me-with-a-long-random-database-password@127.0.0.1:5432/tanzim
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# One-time secret used only by `python -m app.bootstrap_admin`.
# Remove it after the successful bootstrap and keep the password securely.
SYSTEM_ADMIN_PASSWORD=
