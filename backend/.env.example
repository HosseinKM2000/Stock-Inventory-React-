# Copy to .env and adjust. All values have safe dev defaults if unset.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./stock_inventory.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# One-time deployment secret used to create/adopt the permanent system admin.
# Remove it after the first successful bootstrap and keep the password securely.
SYSTEM_ADMIN_PASSWORD=
